# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）
# 先 source 或者用 direnv / dotenv 加载到当前 shell

# LangSmith：追踪与实验平台 https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=wealth-advisor-hybrid-agent

# 阿里云百炼 DashScope：模型调用
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：切换被测模型，默认 qwen3.8-2.4t-a95b
# 其他可用值示例：deepseek-v4-pro-0813
AGENT_MODEL=qwen3.8-2.4t-a95b

# 可选：openevals 判官模型，默认 qwen3.8-max-0902
# 注意：判官需要结构化输出能力，实测 glm-5.3 / deepseek-v4.1-flash 在 openevals 下会报错
JUDGE_MODEL=qwen3.8-max-0902

# LangFuse：LLM 调用观测 https://cloud.langfuse.com（US 区域用 us.cloud.langfuse.com）
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 跨区域访问时适当放宽，默认 5 秒容易读超时导致事件丢弃
LANGFUSE_TIMEOUT=30
