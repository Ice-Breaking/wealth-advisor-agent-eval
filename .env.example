# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）
# 先 source 或者用 direnv / dotenv 加载到当前 shell

# LangSmith：追踪与实验平台 https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=wealth-advisor-hybrid-agent

# 阿里云百炼 DashScope：模型调用
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：切换被测模型，默认 deepseek-v4.1-flash-1017（速度快、额度独立）
# 注意：qwen3.8-2.4t-a95b / qwen-flash / qwen-plus 的免费额度均已耗尽，会返回 403 FreeTierOnly
AGENT_MODEL=deepseek-v4.1-flash-1017

# 判官模型（openevals 与 deepeval 共用这个变量，按需分别指定）
#  - qwen3.8-max-0902：结构化输出最稳，但免费额度已耗尽（403）
#  - deepseek-v4-pro-0813：当前 openevals 判官（配合 json_text_judge.py 的纯文本 JSON 模式）
#  - deepseek-v4.1-flash-1017：当前 deepeval 判官（配合 dashscope_judge.py）
# 判官与被测模型建议分开，避免自我偏好；两套评估各自内部保持同一判官才可比
JUDGE_MODEL=deepseek-v4-pro-0813

# deepeval 判官：无需 OPENAI_API_KEY（靠 dashscope_judge.py 适配层接管）
# 判官单次调用超时 300s × 4 次重试，可在此覆盖 deepeval 自己的整轮预算（默认 180s，必被掐断）
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=3600

# LangFuse：LLM 调用观测 https://cloud.langfuse.com（US 区域用 us.cloud.langfuse.com）
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 跨区域访问时适当放宽，默认 5 秒容易读超时导致事件丢弃
LANGFUSE_TIMEOUT=30
