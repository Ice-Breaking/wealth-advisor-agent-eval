# 复制为 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）
# 先 source 或者用 direnv / dotenv 加载到当前 shell

# LangSmith：追踪与实验平台 https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=wealth-advisor-hybrid-agent

# 阿里云百炼 DashScope：模型调用
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：切换被测模型，默认 qwen3.8-omni-flash（当前确认有余量）
# 注意：额度耗尽史——qwen3.8-2.4t-a95b / qwen-flash / qwen-plus / deepseek-v4.1-flash-1017
#       / deepseek-v4-pro-0813 / glm-5.3 / deepseek-v4.1-flash / kimi-k3 均已 403
AGENT_MODEL=qwen3.8-omni-flash

# 判官模型（openevals 与 deepeval 共用这个变量，按需分别指定）
#  - qwen3.8-omni-flash：当前判官（openevals 配 json_text_judge.py；deepeval 配 dashscope_judge.py）
#    注意：目前与被测模型同模型，存在自我偏好风险——其余模型恢复额度后建议换开（regrade 工具链可对已存回答重打分）
#  - qwen3.8-max-0902：结构化输出曾最稳，免费额度已耗尽（403）
# 判官与被测模型建议分开，避免自我偏好；两套评估各自内部保持同一判官才可比
JUDGE_MODEL=qwen3.8-omni-flash

# deepeval 判官：无需 OPENAI_API_KEY（靠 dashscope_judge.py 适配层接管）
# 判官单次调用超时 300s × 4 次重试，可在此覆盖 deepeval 自己的整轮预算（默认 180s，必被掐断）
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=3600

# LangFuse：LLM 调用观测 https://cloud.langfuse.com（US 区域用 us.cloud.langfuse.com）
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 跨区域访问时适当放宽，默认 5 秒容易读超时导致事件丢弃
LANGFUSE_TIMEOUT=30
